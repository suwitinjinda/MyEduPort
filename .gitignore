# Portfolio Project - .gitignore
# This file covers both backend and frontend directories

# ============================================
# Dependencies
# ============================================
node_modules/
backend/node_modules/
frontend/node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
package-lock.json
yarn.lock
pnpm-lock.yaml

# ============================================
# Environment Variables (IMPORTANT!)
# ============================================
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
.env.*.local
*.env

# Keep example files
!.env.example
!env.example

# ============================================
# Build Outputs
# ============================================
dist/
build/
*.local

# Frontend (Vite/React)
frontend/dist/
frontend/build/
frontend/.vite/
frontend/.vite-cache/
frontend/dist-ssr/

# ============================================
# Backend Specific
# ============================================
backend/uploads/
backend/kb_files/
backend/logs/
backend/*.log
backend/temp/
backend/tmp/

# Database files
*.sqlite
*.sqlite3
*.db
*.db-journal

# ============================================
# IDE and Editor Files
# ============================================
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
*.sublime-project
*.sublime-workspace
*.code-workspace

# ============================================
# Operating System Files
# ============================================
# macOS
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
*.cab
*.msi
*.msix
*.msm
*.msp
*.lnk

# Linux
*~
.directory
.Trash-*

# ============================================
# Testing
# ============================================
coverage/
.nyc_output/
*.test.js.snap
.jest/
test-results/
playwright-report/
playwright/.cache/
frontend/tests/report/

# ============================================
# Logs
# ============================================
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*
pnpm-debug.log*

# ============================================
# Runtime & Cache
# ============================================
*.tmp
*.temp
*.cache
.cache/
.temp/
.parcel-cache/
.npm/
.eslintcache
.stylelintcache

# ============================================
# Optional npm cache
# ============================================
.npm

# ============================================
# Optional REPL history
# ============================================
.node_repl_history

# ============================================
# Output of 'npm pack'
# ============================================
*.tgz

# ============================================
# Yarn Integrity file
# ============================================
.yarn-integrity

# ============================================
# Serverless directories
# ============================================
.serverless/

# ============================================
# FuseBox cache
# ============================================
.fusebox/

# ============================================
# DynamoDB Local files
# ============================================
.dynamodb/

# ============================================
# TernJS port file
# ============================================
.tern-port

# ============================================
# Stores VSCode versions used for testing
# ============================================
.vscode-test

# ============================================
# Backup files
# ============================================
*.bak
*.backup
*~

# ============================================
# Documentation builds
# ============================================
docs/_build/
site/

# ============================================
# Security & Keys (IMPORTANT!)
# ============================================
*.pem
*.key
*.cert
*.crt
*.p12
*.pfx
secrets/
.secrets

# ============================================
# Scripts (keep utility scripts, ignore generated)
# ============================================
# Keep our utility scripts
!backend/listAllUsers.js
!backend/resetAdminPassword.js
!backend/checkAdminUsers.js

# Ignore generated scripts
*.generated.js
*.generated.ts

# SSL private keys — never commit
deploy/ssl/
*.key.pem
*.pem

# Local backups — these hold the whole database and every uploaded file.
# Nothing under backups/ ever belongs in the repository.
backups/
!backups/.gitkeep

# generated design-canvas payload (regenerate from *.dc.html)
doc/personalTest/design/ipip50-personality-test.html
