PORT=4000
JWT_SECRET=replace_me_with_long_random_value
DB_HOST=localhost
DB_PORT=3306
DB_USER=admindb
DB_PASSWORD=your_password_here
DB_NAME=myeduport
UPLOAD_DIR=uploads
OPENAI_API_KEY=

# Anthropic Claude (for EduBot, essay feedback, gap analysis)
# Get API key at https://console.anthropic.com/
ANTHROPIC_API_KEY=your_anthropic_api_key
# Optional model: claude-sonnet-4-20250514 (default), claude-3-5-sonnet-20241022
# CLAUDE_MODEL=claude-sonnet-4-20250514
ADMIN_EMAIL=admin@example.com

# Google OAuth (for Login with Google)
# Create credentials at https://console.cloud.google.com/apis/credentials
# Use "Web application" type, add your frontend origin (e.g. http://localhost:5173)
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
